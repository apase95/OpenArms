+function compactChangedPath(file: string, directory: string) {
+  if (!path.isAbsolute(directory)) return file
+  const root = path.resolve(directory)
+  // Some tool results include an absolute path without the leading slash.
+  const slashlessRoot = root.slice(1)
+  const target = !path.isAbsolute(file) && slashlessRoot && file.startsWith(slashlessRoot + path.sep)
+    ? path.sep + file
+    : path.resolve(root, file)
+  const relative = path.relative(root, target)
+  if (!relative || relative === ".." || relative.startsWith(".." + path.sep) || path.isAbsolute(relative)) return file
+  return "/" + relative.split(path.sep).join("/")
+}
